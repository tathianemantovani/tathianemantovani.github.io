---
import { site } from '../data/site';
import Icon from './Icon.astro';

const showTestimonials = site.testimonials.items.some((item) => item.status === 'aprovado');
const navigation = site.navigation.filter((item) => item.href !== '#depoimentos' || showTestimonials);
---
<a class="skip-link" href="#conteudo">{site.ui.skipLink}</a>
<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand" href="#inicio" aria-label={`${site.identity.monogram}. ${site.identity.name} — ${site.ui.backToTop}`}>
      <span class="brand-monogram" aria-hidden="true">{site.identity.monogram}<span class="brand-dot">.</span></span>
      <span class="brand-name">{site.identity.name}</span>
    </a>
    <button class="menu-toggle" type="button" aria-controls="main-navigation" aria-expanded="false" data-menu-toggle hidden>
      <span data-menu-label data-open-label={site.ui.menuOpen} data-close-label={site.ui.menuClose}>{site.ui.menuOpen}</span>
      <span class="menu-open-icon"><Icon name="menu" /></span>
      <span class="menu-close-icon"><Icon name="close" /></span>
    </button>
    <nav id="main-navigation" class="header-navigation" aria-label={site.ui.navigationLabel} data-menu-navigation data-open="false">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="header-contact" href={site.hero.primaryCta.href} target="_blank" rel="noopener noreferrer">
        {site.hero.primaryCta.label}<Icon name="diagonal" />
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const navigation = header?.querySelector<HTMLElement>('[data-menu-navigation]');
  const label = toggle?.querySelector<HTMLElement>('[data-menu-label]');
  if (header && toggle && navigation && label) {
    const mobile = window.matchMedia('(max-width: 900px)');
    toggle.hidden = false;
    header.dataset.enhanced = 'true';
    const setOpen = (open: boolean, restoreFocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      navigation.dataset.open = String(open);
      label.textContent = (open ? label.dataset.closeLabel : label.dataset.openLabel) ?? '';
      if (restoreFocus) toggle.focus();
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    navigation.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobile.matches && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false, true);
      }
    });
    document.addEventListener('click', (event) => {
      if (mobile.matches && !header.contains(event.target as Node)) setOpen(false);
    });
    mobile.addEventListener('change', () => setOpen(false));
  }
</script>
