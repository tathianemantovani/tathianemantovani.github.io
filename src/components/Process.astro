---
import { site } from '../data/site';

const content = site.process;
const titleId = `${content.id}-titulo`;
---

<section id={content.id} class="section section--light process-section" aria-labelledby={titleId}>
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow"><span class="section-number" aria-hidden="true">09 /</span> {content.eyebrow}</p>
        <h2 id={titleId} class="section-title">{content.title}</h2>
      </div>
      <p class="section-intro">{content.intro}</p>
    </div>

    <h3 class="subsection-title">{content.modalitiesTitle}</h3>
    <div class="card-grid process-grid">
      {content.modalities.map((item, index) => (
        <article class="card modality-card">
          <span class="card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <p class="modality-label">{item.label}</p>
          <h4>{item.title}</h4>
          <p>{item.description}</p>
        </article>
      ))}
    </div>

    <div class="process-flow">
      <h3 class="subsection-title">{content.stepsTitle}</h3>
      <ol class="process-steps">
        {content.steps.map((item, index) => (
          <li class="process-step">
            <span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h4>{item.title}</h4>
            <p>{item.description}</p>
          </li>
        ))}
      </ol>
      <p class="section-note">{content.note}</p>
    </div>
  </div>
</section>
