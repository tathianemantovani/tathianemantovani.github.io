---
import { site } from '../data/site';

const content = site.contact;
const titleId = `${content.id}-titulo`;
---

<section id={content.id} class="section section--dark contact-section" aria-labelledby={titleId}>
  <div class="container contact-grid">
    <div class="contact-copy">
      <p class="eyebrow"><span class="section-number" aria-hidden="true">11 /</span> {content.eyebrow}</p>
      <h2 id={titleId} class="section-title contact-title">{content.title}</h2>
      <p class="section-intro">{content.intro}</p>
      <div class="contact-actions">
        <a class="button button--primary" href={content.whatsapp.href} target="_blank" rel="noopener noreferrer">
          {content.whatsapp.label}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>

    <div class="contact-details">
      <ul class="contact-links">
        <li>
          <span>{content.email.label}</span>
          <a class="text-link" href={content.email.href}>{content.email.address}</a>
        </li>
        <li>
          <span>{content.linkedin.label}</span>
          <a class="text-link" href={content.linkedin.href} target="_blank" rel="noopener noreferrer">
            {site.identity.name}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </li>
        <li>
          <span>{content.github.label}</span>
          <a class="text-link" href={content.github.href} target="_blank" rel="noopener noreferrer">
            {site.identity.name}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </li>
      </ul>
      <p class="section-note">{content.availabilityNote}</p>
    </div>
  </div>
</section>
