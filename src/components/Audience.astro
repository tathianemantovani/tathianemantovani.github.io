---
import { site } from '../data/site';

const content = site.audience;
const titleId = `${content.id}-titulo`;
---

<section id={content.id} class="section section--light audience-section" aria-labelledby={titleId}>
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow"><span class="section-number" aria-hidden="true">07 /</span> {content.eyebrow}</p>
        <h2 id={titleId} class="section-title">{content.title}</h2>
      </div>
      <p class="section-intro">{content.intro}</p>
    </div>

    <div class="card-grid audience-grid">
      {content.items.map((item, index) => (
        <article class="card audience-card">
          <span class="card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <p class="audience-examples"><span>{content.examplesLabel}</span> {item.examples}</p>
        </article>
      ))}
    </div>
  </div>
</section>
